# --- OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Prompt yozib beruvchi "meta" model (foydalanuvchi tanlagan model EMAS).
OPENROUTER_WRITER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=PROMPTING

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./prompting.db
# Vergul bilan ajratilgan ro'yxat. 3000 — PROMPTING front, 3100 — Datum front.
# Production'da frontend domenlari shu yerda bo'lishi SHART, aks holda brauzer
# so'rovni CORS bilan to'sadi.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Ro'yxatga sig'maydigan, o'zgarib turadigan domenlar uchun naqsh (Vercel
# preview deploylari). Bo'sh qoldirilsa faqat CORS_ORIGINS ishlaydi.
CORS_ORIGIN_REGEX=https://pr-[a-z0-9-]*\.vercel\.app
SECRET_KEY=change-me

# Firebase orqali kirish uchun. Sir emas: ID tokendagi `aud` shu qiymat bilan
# solishtiriladi, imzo esa Google'ning ochiq sertifikatlari bilan tekshiriladi.
FIREBASE_PROJECT_ID=

# --- To'lov (pluggable) ---
# mock | payme | click
PAYMENT_PROVIDER=mock
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- LLM ---
# Mahsulot LLM'siz ishlaydi: texnik topshiriq ML yadro va qoidalar asosida
# yig'iladi (tur tasnifi, signallar, stack/server, playbook, UI-UX, domen).
# `false` (standart) — tashqi model umuman chaqirilmaydi: bepul, bir zumda,
# natija har safar bir xil. Quyidagi kalitlar ham kerak emas.
# `true` — LLM tayyor matnni qayta yozib chiqadi.
USE_LLM=false

# TokenMix — asosiy LLM provayderi (OpenAI-mos API, bitta kalitda ko'p model).
# Faqat USE_LLM=true bo'lganda ishlatiladi.
# Ikkita to'siq bor va ikkalasi ham dashboard'da hal qilinadi:
#   1) kalitga model ruxsati: dashboard -> API key -> Models
#      (aks holda 400 "API key is not allowed to access the requested model")
#   2) promo kredit hamma modelda ishlamaydi — pullik balans kerak
#      (aks holda "This model is not available with promotional credits")
TOKENMIX_API_KEY=
TOKENMIX_BASE_URL=https://api.tokenmix.ai/v1
TOKENMIX_MODEL=kimi-k3
TOKENMIX_MODEL_LIGHT=kimi-k3

# Zaxira provayderlar — TokenMix ishlamaganda. Bo'sh qolsa shunchaki
# o'tkazib yuboriladi.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Ikkita zanjir, ikki xil ish uchun. Tartib: birinchisi ishlamasa keyingisiga
# otiladi. HEAVY — to'liq texnik topshiriq (mahsulotning o'zi), oddiysi —
# aniqlashtiruvchi savollar kabi qisqa so'rovlar. Anthropic to'g'ridan-to'g'ri
# kerak bo'lsa zanjirga `anthropic` deb qo'shiladi.
LLM_PROVIDERS=moonshot,openrouter,google
LLM_PROVIDERS_HEAVY=moonshot,openrouter,google

# --- Jonli web-tadqiqot (Linkup, ixtiyoriy) ---
# Raqobatchilarni internetdan topadi. Kalit bo'lmasa xizmat o'chadi.
# OUTPUT_TYPE: searchResults (modelsiz, xom natija) | sourcedAnswer (Linkup
# tomonida model javobni yig'adi — foydaliroq, lekin model natijasi).
LINKUP_API_KEY=
LINKUP_ENABLED=true
LINKUP_DEPTH=standard
LINKUP_OUTPUT_TYPE=sourcedAnswer

# --- Moonshot (Kimi) ---
# Xalqaro kalit `api.moonshot.ai` da ishlaydi; `.cn` boshqa hisob tizimi.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_MODEL_LIGHT=kimi-k2.6
